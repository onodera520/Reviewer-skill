{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reviewer.local/schemas/animatic-input.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "review_mode": {
      "const": "animatic"
    },
    "video": {
      "type": "object",
      "properties": {
        "video_id": {
          "type": "string",
          "minLength": 1
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "video_id",
        "ref",
        "version"
      ],
      "additionalProperties": false
    },
    "shots": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/animatic_shot"
      },
      "minItems": 1
    },
    "expected_sequence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "provided_segments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "shot_id": {
            "type": "string",
            "minLength": 1
          },
          "time_range": {
            "$ref": "#/$defs/time_range"
          }
        },
        "required": [
          "shot_id",
          "time_range"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "asset_id": {
            "type": "string",
            "minLength": 1
          },
          "entity_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "character",
              "scene",
              "prop"
            ]
          },
          "version": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "image_ref": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "asset_id",
          "entity_id",
          "kind",
          "version"
        ],
        "additionalProperties": false,
        "anyOf": [
          {
            "required": [
              "image_ref"
            ]
          },
          {
            "required": [
              "description"
            ]
          }
        ]
      },
      "minItems": 0
    },
    "story_context": {
      "type": "string",
      "minLength": 1
    },
    "static_review_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "shot_id": {
            "type": "string",
            "minLength": 1
          },
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "spec_version": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "shot_id",
          "ref"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "persistent_visual_state": {
      "$ref": "#/$defs/state"
    }
  },
  "required": [
    "schema_version",
    "review_mode",
    "video",
    "shots"
  ],
  "additionalProperties": false,
  "$defs": {
    "evidence": {
      "type": "object",
      "properties": {
        "source_type": {
          "enum": [
            "image",
            "shot_spec",
            "asset",
            "story",
            "persistent_state",
            "video_frame",
            "audio_segment"
          ]
        },
        "source_ref": {
          "type": "string",
          "minLength": 1
        },
        "source_version": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "observation": {
          "type": "string",
          "minLength": 1
        },
        "timestamp": {
          "type": "number",
          "minimum": 0
        },
        "time_range": {
          "$ref": "#/$defs/time_range"
        }
      },
      "required": [
        "source_type",
        "source_ref",
        "locator",
        "observation"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "source_type": {
                "const": "video_frame"
              }
            }
          },
          "then": {
            "required": [
              "timestamp"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "source_type": {
                "const": "audio_segment"
              }
            }
          },
          "then": {
            "required": [
              "time_range"
            ]
          }
        }
      ]
    },
    "fact": {
      "type": "object",
      "properties": {
        "fact_id": {
          "type": "string",
          "minLength": 1
        },
        "entity_id": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "enum": [
            "environment",
            "prop",
            "character",
            "character_state",
            "spatial",
            "background_object_state",
            "lighting_time",
            "scene_condition"
          ]
        },
        "scope": {
          "enum": [
            "scene",
            "entity"
          ]
        },
        "property": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string",
          "minLength": 1
        },
        "world_anchor": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "importance": {
          "enum": [
            "critical",
            "high",
            "medium",
            "low"
          ]
        },
        "basis": {
          "enum": [
            "specified",
            "observed",
            "both"
          ]
        },
        "established_at_shot_id": {
          "type": "string",
          "minLength": 1
        },
        "last_confirmed_at_shot_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "minItems": 1
        }
      },
      "required": [
        "fact_id",
        "entity_id",
        "category",
        "scope",
        "property",
        "value",
        "world_anchor",
        "importance",
        "basis",
        "established_at_shot_id",
        "last_confirmed_at_shot_id",
        "evidence"
      ],
      "additionalProperties": false
    },
    "state": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "scene_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "continuity_segment_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "through_shot_id": {
          "type": "string",
          "minLength": 1
        },
        "coverage_start_shot_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "facts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fact"
          },
          "minItems": 0
        }
      },
      "required": [
        "schema_version",
        "scene_id",
        "continuity_segment_id",
        "through_shot_id",
        "coverage_start_shot_id",
        "facts"
      ],
      "additionalProperties": false
    },
    "time_range": {
      "type": "object",
      "properties": {
        "start": {
          "type": "number",
          "minimum": 0
        },
        "end": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "start",
        "end"
      ],
      "additionalProperties": false
    },
    "shot": {
      "type": "object",
      "properties": {
        "shot_id": {
          "type": "string",
          "minLength": 1
        },
        "scene_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "spec_version": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "clip_id": {
          "type": "string",
          "minLength": 1
        },
        "clip_version": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "image_number": {
          "type": "integer",
          "minimum": 1
        },
        "shot_spec": {
          "anyOf": [
            {
              "type": "object",
              "minProperties": 1
            },
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "image": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "image_id": {
                  "type": "string",
                  "minLength": 1
                },
                "ref": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "image_id",
                "ref"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "image_prompt": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "shot_id",
        "scene_id",
        "spec_version",
        "shot_spec"
      ],
      "additionalProperties": false
    },
    "animatic_shot": {
      "type": "object",
      "properties": {
        "shot_id": {
          "type": "string",
          "minLength": 1
        },
        "scene_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "spec_version": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "clip_id": {
          "type": "string",
          "minLength": 1
        },
        "clip_version": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "image_number": {
          "type": "integer",
          "minimum": 1
        },
        "shot_spec": {
          "anyOf": [
            {
              "type": "object",
              "minProperties": 1
            },
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "image": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "image_id": {
                  "type": "string",
                  "minLength": 1
                },
                "ref": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "image_id",
                "ref"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "image_prompt": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "preview_instruction": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "anchor_position": {
          "enum": [
            "start",
            "representative",
            "end"
          ]
        },
        "continuity_from_previous": {
          "enum": [
            "continuous",
            "new_scene",
            "unknown"
          ]
        },
        "continuity_basis": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "shot_id",
        "scene_id",
        "spec_version",
        "shot_spec"
      ],
      "additionalProperties": false
    }
  }
}
